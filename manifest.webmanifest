{
  "name": "마크다운 뷰어",
  "short_name": "MD 뷰어",
  "description": "모바일에서 마크다운 파일을 열람하고 편집할 수 있는 오프라인 지원 뷰어",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "any",
  "lang": "ko",
  "dir": "ltr",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "mdfile",
          "accept": ["text/markdown", "text/plain", ".md", ".markdown", ".mdown", ".txt"]
        }
      ]
    }
  }
}
