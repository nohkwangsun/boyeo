{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "마크다운 뷰어",
  "version": "1.0.0",
  "identifier": "com.nohkwangsun.markdownviewer",
  "build": {
    "frontendDist": "../www",
    "beforeBuildCommand": "node build-www.js",
    "beforeDevCommand": "node build-www.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "마크다운 뷰어",
        "width": 1000,
        "height": 800,
        "minWidth": 380,
        "minHeight": 420,
        "resizable": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © nohkwangsun",
    "category": "Productivity",
    "shortDescription": "마크다운 뷰어",
    "longDescription": "마크다운 파일을 읽기 좋게 보여주는 뷰어. 블록별 읽어주기와 반복 재생을 지원한다.",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "마크다운 문서",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ]
      }
    }
  }
}
